# Hepsi isteğe bağlıdır. E-posta ayarlanmazsa kodlar sunucu günlüğüne yazılır ve doğrulama kapalı olur.
PORT=3000
DB_PATH=/data/pusula.db
# Yalnızca bu adreslerden API çağrısına izin ver (virgülle). Uygulamayı aynı sunucudan sunuyorsan boş bırak/"*" kalabilir.
ALLOWED_ORIGINS=*
# E-posta seçeneği 0 (ücretsiz, alan adı gerekmez): Brevo — BREVO_API_KEY + MAIL_FROM (Brevo'da doğrulanmış gönderen adresi)
BREVO_API_KEY=
# E-posta seçeneği 1: Resend (resend.com) — ücretsiz katman yeterli
RESEND_API_KEY=
# E-posta seçeneği 2: SMTP (smtps:// = TLS, genelde 465)
SMTP_URL=
MAIL_FROM=Pusula <no-reply@alanadin.com>
# E-posta doğrulamasını zorla (1) / kapat (0). Varsayılan: e-posta ayarlıysa açık.
REQUIRE_VERIFY=
SESSION_DAYS=60
MAX_DATA_BYTES=2097152
# Render/Railway/Fly gibi bir ters vekilin arkasındaysan 1 (varsayılan), doğrudan internete açıksan 0
TRUST_PROXY=1

# --- Aylık abonelik (Lemon Squeezy). İkisi de doluysa ödeme açılır ---
LS_CHECKOUT_URL=
LS_WEBHOOK_SECRET=
PRO_PRICE_LABEL=
# Yeni hesaplara Pro deneme süresi (gün) ve ücretsiz plandaki bulut sınırı (bayt)
TRIAL_DAYS=14
FREE_MAX_DATA_BYTES=102400
# Elle Pro vermek için yönetici anahtarı (boşsa kapalı)
# Yönetim paneli (/admin.html) giriş anahtarı: uzun rastgele bir metin. Boşsa panel kapalı.
ADMIN_TOKEN=

# --- Yerleşik yapay zekâ (kullanıcıdan API anahtarı istenmez; anahtar yalnızca burada durur) ---
# Boşsa kapalı. Gemini için aistudio.google.com/apikey, OpenAI-uyumlu (Groq, OpenRouter, OpenAI) için ilgili anahtar.
AI_KEY=
# ÜCRETSİZ yol: birden çok ücretsiz anahtarı virgülle yaz (AI_KEY=anahtar1,anahtar2); biri kota dolunca sıradakine geçilir.
#   Gemini ücretsiz katman: AI_PROVIDER=gemini, anahtar aistudio.google.com/apikey (kart gerekmez)
#   Groq ücretsiz katman:   AI_PROVIDER=openai, AI_URL=https://api.groq.com/openai/v1, AI_MODEL=<Groq'un güncel model listesinden>
# gemini | openai (openai = OpenAI uyumlu her servis; AI_URL ile adresi değiştir)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_URL=
# Kullanıcı başına günlük mesaj sınırı (maliyeti sınırlar). Ücretsiz plan en fazla 15.
AI_DAILY_LIMIT=40
AI_DAILY_LIMIT_PRO=200

# --- Ücretsiz barındırıcıda hesapların silinmemesi için şifreli yedek (özel GitHub deposu) ---
# Üçü de doluysa veritabanı her değişiklikte (en fazla dakikada bir) şifrelenip yedeklenir, sunucu açılırken dosya yoksa geri yüklenir.
BACKUP_GH_TOKEN=
BACKUP_GH_REPO=
BACKUP_KEY=

# --- Sosyal medya özellikleri: foto ve video için Cloudflare R2 (ücretsiz 10 GB) ---
# R2_ACCOUNT_ID=       Cloudflare hesap kimliği
# R2_ACCESS_KEY_ID=    R2 API belirteci: erişim anahtarı kimliği
# R2_SECRET_ACCESS_KEY= R2 API belirteci: gizli anahtar
# R2_BUCKET=           kova adı
# R2_PUBLIC_URL=       kovanın herkese açık adresi (örn. https://pub-xxxx.r2.dev)

# --- Google Takvim + Gmail (isteğe bağlı) ---
# Google Cloud Console > APIs & Services: Google Calendar API ve Gmail API'yi etkinleştir; OAuth consent screen (External) doldur;
# Credentials > OAuth client ID (Web application). Authorized redirect URI: https://SITENIZ/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sunucu adresi proxy arkasında yanlış çıkarsa elle yaz: https://pusula-3ejq.onrender.com
PUBLIC_URL=

# Görseller: varsayılan olarak bu sunucu üzerinden sunulur ve yüklenir (operatör engeli olan telefonlarda da çalışır).
# Doğrudan R2 adresini kullanmak için 0 yap (sunucu bant genişliğinden tasarruf eder).
# MEDIA_PROXY=1
# Video yükleme üst sınırı (bayt). Varsayılan 150 MB. Hesap: sunucu belleği küçükse (Render ücretsiz 512 MB) 100000000 gibi düşür.
# MAX_VIDEO_BYTES=157286400
